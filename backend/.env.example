# MongoDB Atlas ulanish manzili (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PAROL@cluster0.xxxxx.mongodb.net/ombor?retryWrites=true&w=majority

# Tokenlar uchun maxfiy kalit (uzun tasodifiy matn)
JWT_SECRET=bu-yerga-uzun-tasodifiy-matn-yozing

# Birinchi admin (bazada hech kim bo'lmaganda shu login bilan kirsangiz admin yaratiladi)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin12345

# Frontend manzili (CORS). Bir nechta bo'lsa vergul bilan: https://a.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000
